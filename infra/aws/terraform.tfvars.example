region      = "us-east-2"
bucket_name = "ains-docs-ACCOUNT_ID-use2"
# Empty api_domain uses <elastic-ip>.sslip.io; production API hostname is api.kiensolutions.com.
api_domain  = ""
# Canonical portal for email links. CORS must also allow https://www.kiensolutions.com
# and http://localhost:3000. See web/README.md.
portal_url  = "https://kiensolutions.com"
email_from  = "noreply@example.com"
# Empty app_image builds on the instance from this git-archive bundle.
source_bundle_path = "/path/to/ains-source.tar.gz"
