# Copy to .env and fill in locally. Never commit .env.

# --- Egnyte Internal app (Admin console > Apps & Integrations) ---
# Subdomain only, e.g. quintonsfirm (for quintonsfirm.egnyte.com)
EGNYTE_DOMAIN=
# The app's Client ID
EGNYTE_API_KEY=
# The app's Client Secret
EGNYTE_CLIENT_SECRET=
# Egnyte user the app acts as (password flow)
EGNYTE_USERNAME=
EGNYTE_PASSWORD=
# Optional: if set, used directly and the password flow is skipped
EGNYTE_ACCESS_TOKEN=
# Optional: used to renew the access token on 401/expiry
EGNYTE_REFRESH_TOKEN=
EGNYTE_SCOPES="Egnyte.filesystem Egnyte.webhooks"
EGNYTE_DEV_ROOT=/Shared/AINS-Dev

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-5.1

DATABASE_URL=postgresql+psycopg://ains:ains_dev@localhost:5432/ains
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
