# Copy to .env and fill in locally. Never commit .env.

# --- Optional Egnyte connector, disabled unless STORAGE_BACKEND=egnyte ---
# Subdomain only, e.g. quintonsfirm (for quintonsfirm.egnyte.com)
EGNYTE_DOMAIN=
# The app's Client ID
EGNYTE_API_KEY=
# The app's Client Secret
EGNYTE_CLIENT_SECRET=
# Egnyte user the app acts as (password flow)
EGNYTE_USERNAME=
EGNYTE_PASSWORD=
# Optional: if set, used directly and the password flow is skipped
EGNYTE_ACCESS_TOKEN=
# Optional: used to renew the access token on 401/expiry
EGNYTE_REFRESH_TOKEN=
EGNYTE_SCOPES="Egnyte.filesystem Egnyte.webhooks"
EGNYTE_DEV_ROOT=/Shared/AINS-Dev


DATABASE_URL=postgresql+psycopg://ains:ains_dev@localhost:5432/ains
# Optional synthetic Supabase PostgreSQL proof of concept. Store the real value only in a
# secret manager or uncommitted local environment, and include sslmode=require.
SUPABASE_POC_DATABASE_URL=
SUPABASE_POC_SYNTHETIC_ONLY=false
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
AUDITOR_MFA_ISSUER=Kien Solutions
AUDITOR_MFA_ENROLLMENT_TTL_MINUTES=10
CLIENT_INVITATION_TTL_HOURS=72
# Local synthetic development only. Never enable token previews in a shared or production system.
INVITATION_PREVIEW_ENABLED=false
# Demo only (synthetic data): isolation screen fetches a real foreign engagement id.
ISOLATION_PROBE_ENABLED=false
# Local development only. The portal is http://localhost:3000 and the API is
# http://localhost:8000. Production sets public HTTPS origins and does not include localhost.
CORS_ORIGINS=http://localhost:3000
# In-process limits; 0 disables. Per client address per minute, and concurrent document uploads.
API_RATE_LIMIT_PER_MINUTE=300
UPLOAD_MAX_CONCURRENT=3

# S3 is the primary/default storage. Egnyte requires explicit opt-in.
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
# Cloudflare R2: S3_PROVIDER=r2, AWS_REGION=auto, S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Credentials come from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the environment (never in git).
S3_PROVIDER=aws
S3_ENDPOINT_URL=
S3_BUCKET=
S3_SSE=AES256
# Required when S3_SSE=aws:kms; EC2 uses instance-role AWS credentials.
S3_KMS_KEY_ID=
# Explicit retention for human-finalized reports only, not intake or unsigned drafts.
S3_RETENTION_DAYS=0
S3_RETENTION_MODE=GOVERNANCE
# Days evidence is kept after an engagement completes (placeholder until the attorney sets it).
RECORD_RETENTION_DAYS=2190
RESEND_API_KEY=
EMAIL_FROM=
# Optional invitation sender; defaults to EMAIL_FROM when empty.
INVITE_EMAIL_FROM=
# Comma-separated invitee emails for `python -m app.pilot_seed` (synthetic pilot only).
PILOT_INVITEE_EMAILS=
PORTAL_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=15

# Optional Sentry; blank DSNs disable monitoring. No auth token needed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DSN=

# Upload scanning: off (dev) or clamav (needs clamd with StreamMaxLength >= 100M; scan failure blocks uploads)
UPLOAD_SCAN_MODE=off
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
# Failed sign-in lockout
SIGNIN_MAX_PER_EMAIL=5
SIGNIN_MAX_PER_IP=30
SIGNIN_LOCKOUT_MINUTES=15
