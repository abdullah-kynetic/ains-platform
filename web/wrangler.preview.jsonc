{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kien-signin-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{"pattern":"preview.kiensolutions.com","custom_domain":true}],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "kien-signin-preview" }
  ]
}
