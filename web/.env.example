# Kien Solutions web portal. Copy to .env.local; never commit real values.
# Local API. The dev portal is http://localhost:3000; local CORS_ORIGINS must include that origin.
# Production builds use https://api.kiensolutions.com and do not use this localhost URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
# "true" = use built-in synthetic mock data instead of calling the API.
NEXT_PUBLIC_USE_MOCKS=false
# Max upload size shown/enforced in the UI (Egnyte simple upload limit is 100 MB).
NEXT_PUBLIC_MAX_UPLOAD_MB=100

# Optional Sentry; blank DSNs disable monitoring. No auth token needed.
NEXT_PUBLIC_SENTRY_DSN=
