# AINS web portal. Copy to .env.local; never commit real values.
# Base URL of the AINS FastAPI backend (ains-platform/app).
NEXT_PUBLIC_API_URL=http://localhost:8000
# "true" = use built-in synthetic mock data instead of calling the API.
NEXT_PUBLIC_USE_MOCKS=false
# Max upload size shown/enforced in the UI (Egnyte simple upload limit is 100 MB).
NEXT_PUBLIC_MAX_UPLOAD_MB=100
