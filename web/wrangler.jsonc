{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ains-platform-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "env": {
    "production": {
      "name": "ains-platform",
      "workers_dev": false,
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "ains-platform" }
      ]
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "ains-platform-demo" }
  ]
}
