{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ains-platform-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "env": {
    "production": {
      "name": "ains-platform",
      "workers_dev": false,
      // Public build-time setting (not a secret). Read by scripts/wrangler-public-api-url.mjs.
      "vars": {
        "NEXT_PUBLIC_API_URL": "https://api.kiensolutions.com"
      },
      // Attach *.kiensolutions.com in Cloudflare as a route. Apex and www stay on the landing Worker.
      // See web/README.md. A wildcard custom domain is not supported.
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "ains-platform" }
      ]
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "ains-platform-demo" }
  ]
}
