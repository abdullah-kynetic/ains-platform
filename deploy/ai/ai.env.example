# Variable NAMES only. Real values go in /etc/kien/ai.env (root, mode 600), never in git or chat.
# AI service (ai-adapter container):
AI_ENABLED=false                 # set true only when Abdullah says go
AI_SERVICE_TOKEN=                # long random string; the API presents the same value
OPENROUTER_API_KEY=              # trial key with a spending limit; only this service ever sees it
AI_OWNERSHIP_DATABASE_URL=       # URL for the read-only role made by deploy/ai/readonly-role.sql
# AI_ALLOWED_HOSTS and the base URL default to openrouter.ai only; do not change them.
#
# API side (names go in the API's env file: /etc/kien/kien.env in deploy/docker-compose.prod.yml,
# /etc/kien/app.env on the live server; check which one the api service reads):
# AI_ANALYSIS_ENABLED=false      # the API switch; every AI route is 404 while false
# AI_SERVICE_URL=http://ai-adapter:8100
# AI_SERVICE_TOKEN=              # identical to the value above
