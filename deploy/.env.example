# Variable NAMES only. Real values go in /etc/kien/kien.env (root, mode 600), never in git or chat.
KIEN_IMAGE=
API_HOST=
STAGING_HOST=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

SESSION_SECRET=
SESSION_COOKIE_SECURE=true
# Every portal origin (each firm host and the auditor host), https, comma separated. The API also uses
# this exact list to refuse cross-site POST/PUT/PATCH/DELETE, so a missing firm host gets 403 on sign-in.
CORS_ORIGINS=
PORTAL_URL=

STORAGE_BACKEND=s3
# Set by deploy/docker-compose.prod.yml for the API: ENV=production, UPLOAD_SCAN_MODE=clamav, CLAMD_HOST=clamav
S3_PROVIDER=r2
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RESEND_API_KEY=
EMAIL_FROM=
INVITE_EMAIL_FROM=
