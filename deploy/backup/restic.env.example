# Names only. Real file: /etc/kien/restic.env (root, mode 600). Backup-only R2 token here.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/kien-prod-backups
RESTIC_PASSWORD_FILE=/etc/kien/restic.pass
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
HEALTHCHECK_PING_URL=
# Document copy (rclone remotes named in /etc/kien/rclone.conf, root, mode 600)
DOCS_SRC=r2prod:kien-prod-documents
DOCS_DST=r2backup:kien-prod-backups-docs
DOCS_PING_URL=
ALERT_PING_URL=
