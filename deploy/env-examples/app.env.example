# /etc/kien/app.env (root, mode 600). api + worker only. Names only, values never in git or chat.
# kien_app has DML only (no DDL); created by deploy/bootstrap/db-roles.sql.
DATABASE_URL=postgresql+psycopg://kien_app:PASSWORD@postgres:5432/kien

SESSION_SECRET=
# Every portal origin (each firm host and the auditor host), https, comma separated. The API also uses
# this exact list to refuse cross-site POST/PUT/PATCH/DELETE, so a missing firm host gets 403 on sign-in.
CORS_ORIGINS=
PORTAL_URL=

# Set by deploy/docker-compose.prod.yml: ENV=production, UPLOAD_SCAN_MODE=clamav, CLAMD_HOST=clamav
STORAGE_BACKEND=s3
S3_PROVIDER=r2
S3_ENDPOINT_URL=
S3_BUCKET=kien-prod-documents
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RESEND_API_KEY=
EMAIL_FROM=
INVITE_EMAIL_FROM=
